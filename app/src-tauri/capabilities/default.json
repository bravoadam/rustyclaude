{
  "identifier": "sidebar",
  "description": "The local UI: account sidebar and title bar.",
  "webviews": [
    "sidebar",
    "titlebar"
  ],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-select-account",
    "allow-add-account",
    "allow-rename-account",
    "allow-set-account-color",
    "allow-move-account",
    "allow-remove-account",
    "allow-set-panel",
    "allow-focus-self",
    "allow-list-hosts",
    "allow-host-send",
    "allow-hosts-path",
    "allow-notify-native",
    "allow-begin-oauth",
    "allow-cancel-oauth",
    "allow-get-autostart",
    "allow-set-autostart",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
